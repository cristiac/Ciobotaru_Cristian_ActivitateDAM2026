<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F2F5"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- HEADER & AI AUTO-FILL -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="#673AB7">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✨ Smart AI Assistant"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvAiStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Status AI: Introdu datele sau generează"
                    android:textColor="#E0E0E0"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btnGenerareAi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:backgroundTint="#FF4081"
                    android:text="🎲 Generare Magică (AI)"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- FORMULAR CARD -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:cardBackgroundColor="#FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <EditText
                    android:id="@+id/etRasaAi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Rasa curcanului (ex: Bronzat)"
                    android:layout_marginBottom="12dp" />

                <CheckBox
                    android:id="@+id/cbMaturAi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Exemplar adult / matur"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tip Hrană Recomandată:"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spHranaAi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp" />

                <RadioButton
                    android:id="@+id/rbMasculinAi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Masculin"
                    android:checked="true"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Evaluare Sănătate AI:"
                    android:textStyle="bold" />

                <RatingBar
                    android:id="@+id/rbSanatateAi"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:numStars="5"
                    android:stepSize="1.0"
                    android:rating="3.0"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="12dp" />

                <Switch
                    android:id="@+id/swVaccinatAi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Vaccinat la zi"
                    android:layout_marginBottom="20dp" />

                <Button
                    android:id="@+id/btnSalveazaAi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Salvează Obiectul"
                    android:backgroundTint="#673AB7"
                    android:padding="12dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>