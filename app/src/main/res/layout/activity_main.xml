<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:id="@+id/main"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/salut_ce_faci" />

    <EditText
        android:id="@+id/nume_et"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/exemplu_ion" />

    <CheckBox
        android:id="@+id/esteZi_CB"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Este zi?" />

    <Button
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:onClick="culegeDate"
        android:text="@string/apasa" />
    <Button
        android:id="@+id/btnDeschideAi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Adaugă cu AI"
        android:onClick="culegeDateAi" />

</LinearLayout>
